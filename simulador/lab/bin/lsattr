#!/bin/bash
# Simulador ASM ADD DISK BRABO — comando FALSO (lê/grava /sim/mundo). by • DBA BRABO
. /sim/lab/lib.sh
d=""; a=""
while (( $# )); do case $1 in -l|-El|-lE) d=$2; shift 2 ;; -a) a=$2; shift 2 ;; *) shift ;; esac; done
[[ -n ${SIM_NO:-} ]] && d=$(awk -F'|' -v h="$d" '$2==h{print $1; f=1} END{if(!f) print h}' "$M/aixmap.tsv")
IFS='|' read -r h st pv vg rp uid mb < <(awk -F'|' -v d="$d" '$1==d' "$M/aix.tsv")
[[ -n ${h:-} ]] || exit 1
case $a in reserve_policy) echo "$rp" ;; unique_id) echo "$uid" ;; esac
