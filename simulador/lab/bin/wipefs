#!/bin/bash
# Simulador ASM ADD DISK BRABO — comando FALSO (lê/grava /sim/mundo). by • DBA BRABO
. /sim/lab/lib.sh
k=$(kname_de "${!#}"); sig=$(dev_campo "$k" 9)
[[ -n $sig ]] || exit 0
t=$(tr ';' '\n' <<<"$sig" | awk -F= '$1=="TYPE"{print $2}')
u=$(tr ';' '\n' <<<"$sig" | awk -F= '$1=="UUID"{print $2}')
printf 'offset               type\n----------------------------------------------------------------\n'
printf '0x0                  %s   [filesystem]\n                     UUID:  %s\n' "$t" "$u"
